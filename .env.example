# Copia este archivo como .env en la raiz. Nunca lo incluyas en Git.
# Conexion copiada de Neon > Connect. Conserva sslmode y channel_binding.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require&channel_binding=require
NODE_SECRET_KEY=replace-with-a-random-secret-before-deployment
NODE_DEBUG_MODE=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Habilita PGlite con --local-demo o NODE_LOCAL_DEMO=true.
NODE_LOCAL_DEMO=false
# PORT=8000
# TRUST_PROXY_HOPS=0
# RUN_PAYMENT_EMAIL_WORKER=true

# Acceso y recuperacion de contrasena: configura Resend para enviar los codigos.
# Remitente verificado, por ejemplo: App Finanzas Mauricio <seguridad@tudominio.com>
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Opcional: direccion que recibira las respuestas de los usuarios.
RESEND_REPLY_TO_EMAIL=
RESEND_TIMEOUT_SECONDS=10

# Sesion persistente: se renueva con el uso y solo admite un dispositivo activo.
LOGIN_SESSION_DAYS=365

# Stripe: exclusivamente entorno de pruebas. Completa las tres claves aqui.
# La API entrega la clave publicable a React; no requiere otro .env.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# stripe listen --events payment_intent.succeeded,payment_intent.payment_failed --forward-to http://127.0.0.1:8000/api/stripe/webhook/
STRIPE_WEBHOOK_SECRET=
